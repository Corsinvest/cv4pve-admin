@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="schedule" Title="Scheduled jobs">
            Cron expressions decide when each job takes its snapshots, across VMs and containers.
        </OverviewFeature>
        <OverviewFeature Icon="auto_delete" Title="Retention">
            Each job keeps a set number of snapshots and removes the older ones.
        </OverviewFeature>
        <OverviewFeature Icon="timeline" Title="Timeline and errors">
            Every run is recorded, with its result and the errors of the snapshots that failed.
        </OverviewFeature>
        <OverviewFeature Icon="storage" Title="Snapshot size">
            The space taken by snapshots over time, so that storage does not fill up unnoticed.
        </OverviewFeature>
        <OverviewFeature Icon="hub" Title="Multi-cluster">
            Jobs on several clusters, with access limited by permissions.
        </OverviewFeature>
        <OverviewFeature Icon="widgets" Title="Dashboard widgets">
            Status, size and failed snapshots are also available as widgets for the dashboards.
        </OverviewFeature>
    </Features>
</ModuleOverview>
