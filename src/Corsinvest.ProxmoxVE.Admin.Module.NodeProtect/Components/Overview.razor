@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="backup" Title="Configuration backup">
            Backs up the configuration settings of Proxmox VE nodes.
        </OverviewFeature>
        <OverviewFeature Icon="settings_backup_restore" Title="Easy restoration">
            Restore a node configuration quickly and accurately after a failure.
        </OverviewFeature>
        <OverviewFeature Icon="schedule" Title="Automated backups">
            Node configuration backups run and are managed automatically.
        </OverviewFeature>
    </Features>
</ModuleOverview>
