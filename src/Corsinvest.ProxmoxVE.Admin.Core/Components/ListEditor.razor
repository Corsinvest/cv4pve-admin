@inherits AdminComponentBase
@typeparam TItem

@* Editable list with always-open rows: add, remove and, optionally, move up/down.
   The row fields come from ItemTemplate; the list is changed in place. *@

<RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
    @for (var i = 0; i < Items.Count; i++)
    {
        var index = i;
        var item = Items[index];

        <RadzenStack @key="item" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
            @if (AllowReorder)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0" Style="flex-shrink:0;">
                    <RadzenButton Icon="arrow_upward"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Base"
                                  Size="ButtonSize.Small"
                                  Disabled="@(Disabled || index == 0)"
                                  Click="@(() => MoveAsync(index, -1))"
                                  title="@L["Move up"]"
                                  aria-label="@L["Move up"]" />
                    <RadzenButton Icon="arrow_downward"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Base"
                                  Size="ButtonSize.Small"
                                  Disabled="@(Disabled || index == Items.Count - 1)"
                                  Click="@(() => MoveAsync(index, 1))"
                                  title="@L["Move down"]"
                                  aria-label="@L["Move down"]" />
                </RadzenStack>
            }

            @ItemTemplate(item)

            <RadzenButton Icon="delete"
                          Variant="Variant.Text"
                          ButtonStyle="ButtonStyle.Danger"
                          Size="ButtonSize.Small"
                          Disabled="@Disabled"
                          Click="@(() => RemoveAsync(item))"
                          Style="flex-shrink:0;"
                          title="@L["Remove"]"
                          aria-label="@L["Remove"]" />
        </RadzenStack>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
        <RadzenButton Icon="add"
                      Text="@(AddText ?? L["Add"])"
                      ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small"
                      Disabled="@Disabled"
                      Click="@AddAsync" />
        @ToolbarContent
    </RadzenStack>
</RadzenStack>

@code
{
    [Parameter, EditorRequired] public IList<TItem> Items { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TItem> ItemTemplate { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem> NewItem { get; set; } = default!;

    /// <summary>Shows up/down buttons: use it when the order matters (e.g. priority).</summary>
    [Parameter] public bool AllowReorder { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? AddText { get; set; }

    /// <summary>Extra buttons next to Add.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Raised after a row is added, removed or moved.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private Task AddAsync()
    {
        Items.Add(NewItem());
        return Changed.InvokeAsync();
    }

    private Task RemoveAsync(TItem item)
    {
        Items.Remove(item);
        return Changed.InvokeAsync();
    }

    private Task MoveAsync(int index, int offset)
    {
        var target = index + offset;
        if (target < 0 || target >= Items.Count) { return Task.CompletedTask; }

        (Items[index], Items[target]) = (Items[target], Items[index]);
        return Changed.InvokeAsync();
    }
}
