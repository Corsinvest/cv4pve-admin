@inherits AdminComponentBase

<RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
    @L["These addresses are used for both the Proxmox VE API and SSH. For the API, nodes are tried in this order until one responds."]
</RadzenText>

<ListEditor TItem="ClusterNodeSettings"
            Items="@Model.Nodes"
            NewItem="@(() => new ClusterNodeSettings())"
            AllowReorder="true"
            Disabled="@Disabled"
            AddText="@L["Add node"]">
    <ToolbarContent>
        <RadzenButton Variant="Variant.Text"
                      Size="ButtonSize.Small"
                      Text="@L["Discover Nodes"]"
                      Disabled="@(Disabled || !Model.Nodes.Any())"
                      Click="DiscoverAsync"
                      ButtonStyle="ButtonStyle.Success"
                      Icon="travel_explore" />
    </ToolbarContent>

    <ItemTemplate Context="node">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0" class="rz-w-100">
            <RadzenTextBox Name="@FieldName(node, nameof(node.IPAddress))"
                           @bind-Value="@node.IPAddress"
                           Placeholder="@L["IP Address/Host"]"
                           Disabled="@Disabled"
                           title="@L["IP Address/Host"]"
                           class="rz-w-100" />
            <RadzenDataAnnotationValidator Component="@FieldName(node, nameof(node.IPAddress))" />
        </RadzenStack>

        <RadzenNumeric Name="@FieldName(node, nameof(node.ApiPort))"
                       @bind-Value="@node.ApiPort"
                       Min="1"
                       Max="65535"
                       Disabled="@Disabled"
                       title="@L["API Port"]"
                       Style="width:7rem;flex-shrink:0;" />
    </ItemTemplate>
</ListEditor>
