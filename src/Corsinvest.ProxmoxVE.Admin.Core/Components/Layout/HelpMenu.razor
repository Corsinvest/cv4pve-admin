@inherits AdminComponentBase

<RadzenButton Variant="Variant.Text"
              ButtonStyle="ButtonStyle.Light"
              class="rz-button-icon-only"
              Click="ShowHelpMenu"
              title="@HelpTitle"
              aria-label="@HelpTitle"
              Style="position: relative;">

    <RadzenIcon Icon="help_outline" />

    @if (NewRelease != null)
    {
        <RadzenBadge BadgeStyle="BadgeStyle.Danger"
                     IsPill="true"
                     Style="position: absolute; top: 6px; right: 6px; width: 8px; min-width: 8px; height: 8px; padding: 0;" />
    }
</RadzenButton>

@code {
    private void ShowHelpMenu(MouseEventArgs args)
    {
        args.ClientY += 24;

        contextMenuService.Open(args, ds =>
        @<RadzenMenu Click="@(() => ds.Close())">
            <RadzenStack Style="padding: 0 6px 5px 10px;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: bold; margin: 0;">@AppSettings.AppName</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color" Style="margin: 0;">@BuildInfo.Version</RadzenText>
                <RadzenBadge Text="@BuildInfo.EditionFull" BadgeStyle="@(BuildInfo.IsEnterpriseEdition? BadgeStyle.Warning: BadgeStyle.Primary)" />
                <RadzenButton Icon="refresh"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Base"
                              Size="ButtonSize.ExtraSmall"
                              Style="margin-left: auto;"
                              Click="@(async () => { ds.Close(); await CheckForUpdatesAsync(); })"
                              title="@L["Check for updates"]"
                              aria-label="@L["Check for updates"]" />
            </RadzenStack>

            @if (NewRelease != null)
            {
                <RadzenStack Style="padding: 0 0 5px 10px;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <a href="@NewRelease.Url" target="_blank" title="@L["Open the release page"]" style="text-decoration: none;">
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Shade="Shade.Lighter" Style="cursor: pointer;">
                            @L["Update available {0}", NewRelease.Version]
                            <RadzenIcon Icon="open_in_new" Style="font-size: 0.85rem; margin-left: 2px; vertical-align: middle;" />
                        </RadzenBadge>
                    </a>
                    @if (releaseService.IsAutoUpdateSupported)
                    {
                        <PermissionView PermissionKey="@ApplicationPermissions.Upgrade.Key"
                                        PermissionClusterName="@ApplicationHelper.AllClusterName"
                                        Path="*">
                            <RadzenButton Icon="upgrade"
                                          Text="@L["Update"]"
                                          ButtonStyle="ButtonStyle.Success"
                                          Variant="Variant.Flat"
                                          Size="ButtonSize.ExtraSmall"
                                          Click="@(async () => { ds.Close(); await TriggerUpdateAsync(); })"
                                          title="@L["Trigger automatic update"]"
                                          IsBusy="@IsUpdating" />
                        </PermissionView>
                    }
                </RadzenStack>
            }

            <hr style="margin: 4px 0;" />

            <RadzenMenuItem Icon="menu_book" Path="@DocumentationUrl" Target="_blank">
                <Template>
                    <span style="display: flex; align-items: center; gap: 0.5rem; width: 100%;">
                        <span style="flex: 1;">@DocumentationText</span>
                        <RadzenLink Path="@DocumentationOnlineUrl"
                                    Target="_blank"
                                    title="@L["Open online version"]"
                                    @onclick:stopPropagation="true"
                                    Style="display: inline-flex; align-items: center; padding: 0.15rem 0.3rem;">
                            <RadzenIcon Icon="cloud" Style="font-size: 1rem; color: var(--rz-text-secondary-color);" />
                        </RadzenLink>
                    </span>
                </Template>
            </RadzenMenuItem>
            <RadzenMenuItem Text="@L["Release notes"]" Icon="celebration" Click="@(async () => { ds.Close(); await ShowReleaseNotesAsync(); })" />
            <RadzenMenuItem Text="@L["Support"]" Icon="support_agent" Path="https://github.com/Corsinvest/cv4pve-admin/issues" Target="_blank" />

            <hr style="margin: 4px 0;" />

            <RadzenMenuItem Text="@L["Keyboard Shortcuts"]" Icon="keyboard" Click="@(async () => { ds.Close(); await ShowKeyboardShortcutsAsync(); })" />

            <hr style="margin: 4px 0;" />
            <RadzenMenuItem Text="@L["Report a Bug"]" Icon="bug_report" Click="@(async () => { ds.Close(); await OpenBugUrlAsync(); })" />
            <RadzenMenuItem Text="@L["Request a Feature"]" Icon="auto_awesome" Path="@ApplicationHelper.FeatureRequestUrl" Target="_blank" />
            <RadzenMenuItem Text="@L["Provide Feedback"]" Icon="feedback" Path="@ApplicationHelper.FeedbackUrl" Target="_blank" />
            <RadzenMenuItem Text="@L["Who is using cv4pve-admin?"]" Icon="groups" Click="@(async () => { ds.Close(); await OpenWhoIsUsingUrlAsync(); })" />
        </RadzenMenu>);
    }
}
