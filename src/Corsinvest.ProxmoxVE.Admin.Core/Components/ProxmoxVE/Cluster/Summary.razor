@inherits AdminComponentBase

<RadzenStack Orientation="Orientation.Vertical" Gap="10px" class="rz-w-100">
    <div class="cv4pve-summary-kpis">
        <div class="cv4pve-card">
            <div class="cv4pve-kpi cv4pve-widget-state @ClusterState" style="justify-content: center;">
                <span class="cv4pve-kpi-section-title" style="margin: 0;">@L["Cluster"]</span>
                <div class="cv4pve-kpi-row" style="gap: 0.75rem;">
                    <span class="cv4pve-kpi-badge @ClusterState"><RadzenIcon Icon="@(StatusInfo.Icon ?? "hourglass_empty")" /></span>
                    <div style="display: flex; flex-direction: column; min-width: 0;">
                        <span class="cv4pve-kpi-value" style="font-size: 1.4rem;">@ClusterTitle</span>
                        <span class="cv4pve-kpi-caption">@ClusterCaption</span>
                    </div>
                </div>
            </div>
        </div>

        @if (CephInstalled)
        {
            <div class="cv4pve-card">
                <div class="cv4pve-kpi cv4pve-widget-state @CephState" style="justify-content: center;">
                    <span class="cv4pve-kpi-section-title" style="margin: 0;">@L["Ceph"]</span>
                    <div class="cv4pve-kpi-row" style="gap: 0.75rem;">
                        <span class="cv4pve-kpi-badge @CephState"><RadzenIcon Icon="@CephStatus.Icon" /></span>
                        <span class="cv4pve-kpi-value" style="font-size: 1.1rem;">@CephStatus.Status</span>
                    </div>
                </div>
            </div>
        }

        <div class="cv4pve-card">
            <Corsinvest.ProxmoxVE.Admin.Core.Components.ProxmoxVE.Common.GridResourceStatus ResourceType="ClusterResourceType.Node"
                                                                                            ClusterName="@ClusterName"
                                                                                            ShowHeader="true" />
        </div>

        @foreach (var type in Enum.GetValues<VmType>())
        {
            <div class="cv4pve-card">
                <Corsinvest.ProxmoxVE.Admin.Core.Components.ProxmoxVE.Common.GridResourceStatus ResourceType="ClusterResourceType.Vm"
                                                                                                VmType="type"
                                                                                                ClusterName="@ClusterName"
                                                                                                ShowHeader="true" />
            </div>
        }

        <div class="cv4pve-card">
            <Corsinvest.ProxmoxVE.Admin.Core.Components.ProxmoxVE.Common.GridResourceStatus ResourceType="ClusterResourceType.Storage"
                                                                                            ClusterName="@ClusterName"
                                                                                            ShowHeader="true" />
        </div>
    </div>

    <div class="cv4pve-card" style="height: auto;">
        <Corsinvest.ProxmoxVE.Admin.Core.Components.ProxmoxVE.Common.ResourceUsageRings Data="@DataUsages" />
    </div>

    <div class="cv4pve-card" style="height: auto; padding: 0;">
        <RadzenDataGrid TItem="ClusterStatus"
                        Data="@Nodes"
                        AllowFiltering="false"
                        AllowColumnResize="true"
                        AllowAlternatingRows="false"
                        AllowSorting="false"
                        Density="Density.Compact"
                        FilterPopupRenderMode="PopupRenderMode.OnDemand"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(ClusterStatus.Name)" Title="@L["Node"]" />
                <RadzenDataGridColumn Property="@nameof(ClusterStatus.Id)" Title="@L["Id"]" />
                <RadzenDataGridColumn Property="@nameof(ClusterStatus.Support)" Title="@L["Support"]" />
                <BoolIconColumn Property="@nameof(ClusterStatus.IsOnLine)" Title="@L["Is OnLine"]" IconFalse="" />
                <RadzenDataGridColumn Property="@nameof(ClusterStatus.IpAddress)" Title="@L["Ip Address"]" />
                <BaseColumn Property="@nameof(ClusterStatus.CpuUsagePercentage)" Title="@L["Cpu %"]" UseProgressBarPercentage="true" />
                <BaseColumn Property="@nameof(ClusterStatus.MemoryUsagePercentage)" Title="@L["Memory %"]" UseProgressBarPercentage="true" />

                <RadzenDataGridColumn Property="@nameof(ClusterStatus.Uptime)" Title="@L["Uptime"]">
                    <Template>
                        @FormatHelper.UptimeInfo(context.Uptime)
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</RadzenStack>

@code
{
    private string ClusterState
        => StatusInfo.Icon switch
        {
            null => "neutral",
            "check_circle" => "ok",
            _ => "ko"
        };

    private string CephState
        => CephStatus?.Status switch
        {
            "HEALTH_OK" => "ok",
            "HEALTH_WARN" => "warn",
            null => "neutral",
            _ => "ko"
        };
}
