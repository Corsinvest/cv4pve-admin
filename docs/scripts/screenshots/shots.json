      "url": "/module/*/system/notifications",
      "actions": [
        { "click": ".rz-data-row:has-text('Operations team') td >> nth=1" },
        { "wait": 800 }
      ],
      "padding": 8,
      "clip": [".rz-tabview-nav", ".rz-data-row:has-text('Operations team')"],
      "boxes": [".rz-data-row:has-text('Operations team')", "button:has-text('Test') >> visible=true"]
    },
    {
      "id": "notifier-webhook",
      "file": "configuration/notifier-webhook.png",
