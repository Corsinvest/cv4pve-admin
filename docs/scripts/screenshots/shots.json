      "expect": [{ "selector": ".rz-dialog-side input[name=Email]", "value": "jane.doe@example.com" }],
      "clip": [".rz-dialog-side .rz-tabview-nav", ".rz-dialog-side .rz-form-field:has(input[name=DisplayName])", ".rz-dialog-side .rz-switch >> nth=-1"]
    },
    {
      "id": "users-roles",
      "edition": "ee",
      "file": "configuration/security-user-roles.png",
      "url": "/module/*/system/security/users",
      "actions": [
        { "click": ".rz-data-row :text-is('jane.doe@example.com')" },
        { "waitFor": ".rz-dialog-side input[name=Email]" },
        { "click": ".rz-dialog-side .rz-tabview-nav li:has-text('Roles')" },
        { "waitFor": ".rz-dialog-side .rz-picklist" },
        { "wait": 800 }
      ],
      "clip": [".rz-dialog-side"],
      "padding": 0,
