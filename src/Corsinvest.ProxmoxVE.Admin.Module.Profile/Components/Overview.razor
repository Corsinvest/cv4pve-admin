@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="password" Title="Password">
            Change the password of your account.
        </OverviewFeature>
        <OverviewFeature Icon="verified_user" Title="Two-factor authentication">
            Enable or disable 2FA for your account.
        </OverviewFeature>
        <OverviewFeature Icon="devices" Title="Active sessions">
            See your active sessions and spot suspicious logins.
        </OverviewFeature>
        <OverviewFeature Icon="person" Title="Autonomy">
            Manage your credentials and logins without an administrator.
        </OverviewFeature>
    </Features>
</ModuleOverview>
