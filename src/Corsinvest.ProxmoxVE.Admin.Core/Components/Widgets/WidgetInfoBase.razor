@inherits AdminComponentBase
@typeparam TSettings

<div class="cv4pve-kpi" style="gap: 1rem; overflow: auto;">
    <div class="cv4pve-kpi-stats">
        @foreach (var stat in Stats)
        {
            <div class="cv4pve-kpi-stat" style="@($"--cv4pve-kpi-stat-color: {stat.Color};")">
                <span class="cv4pve-kpi-section-title" style="margin: 0;">@stat.Title</span>
                <span class="cv4pve-kpi-value">
                    @if (IsLoadingStats && stat.Value == "...")
                    {
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                    }
                    else
                    {
                        @stat.Value
                    }
                </span>
                <span class="cv4pve-kpi-caption">@stat.Subtitle</span>
            </div>
        }
    </div>

    <RadzenRow Gap="1.5rem" RowGap="1rem">
        <RadzenColumn Size="12" SizeSM="6">
            <div class="cv4pve-kpi-section-title">
                @L["Alerts / warnings"]
                @if (IsLoadingAlerts)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                }
            </div>

            <div class="cv4pve-kpi-list">
                @foreach (var alert in Alerts)
                {
                    <div class="cv4pve-kpi-row">
                        <RadzenIcon Icon="@alert.Icon" class="@alert.Color" Style="font-size: 18px;" />
                        <span>@alert.Text</span>
                    </div>
                }
                @if (!IsLoadingAlerts && !Alerts.Any())
                {
                    <div class="cv4pve-kpi-row">
                        <RadzenIcon Icon="check_circle" class="rz-color-success" Style="font-size: 18px;" />
                        <span>@L["No issues found"]</span>
                    </div>
                }
            </div>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeSM="6">
            <div class="cv4pve-kpi-section-title">
                @L["Age distribution"]
                @if (IsLoadingDistribution)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                }
            </div>

            <div class="cv4pve-kpi-list" style="gap: 0.4rem;">
                @foreach (var item in AgeDistribution)
                {
                    <div class="cv4pve-kpi-row">
                        <span style="width: 3.5rem; flex-shrink: 0;" class="cv4pve-kpi-caption">@item.Label</span>
                        <RadzenProgressBar Value="@item.Percent"
                                           ShowValue="false"
                                           ProgressBarStyle="@item.Style"
                                           Style="height: 8px; flex: 1;" />
                        <span class="cv4pve-kpi-row-count" style="min-width: 2.5rem; text-align: right;">@item.Value</span>
                    </div>
                }
            </div>
        </RadzenColumn>
    </RadzenRow>
</div>
