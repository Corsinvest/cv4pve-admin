@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="schedule" Title="Scheduled health checks">
            Regular diagnostic scans with configurable cron schedules.
        </OverviewFeature>
        <OverviewFeature Icon="search" Title="Issue detection">
            Finds misconfigurations, hardware problems and performance bottlenecks early.
        </OverviewFeature>
        <OverviewFeature Icon="analytics" Title="Analysis">
            Examines system logs, configurations and resource utilization.
        </OverviewFeature>
        <OverviewFeature Icon="playlist_remove" Title="Issue tracking">
            History of the problems found, with the option to ignore known non-critical ones.
        </OverviewFeature>
        <OverviewFeature Icon="task_alt" Title="Actionable results">
            Clear descriptions of the issues, with recommendations for resolution.
        </OverviewFeature>
    </Features>
</ModuleOverview>
