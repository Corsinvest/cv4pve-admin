@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="send" Title="Remote control">
            Execute commands and manage nodes through a Telegram bot.
        </OverviewFeature>
        <OverviewFeature Icon="notifications_active" Title="Real-time alerts">
            Instant notifications for cluster events and status changes.
        </OverviewFeature>
        <OverviewFeature Icon="key" Title="Secure access">
            Token-based authentication controls who can use the bot.
        </OverviewFeature>
        <OverviewFeature Icon="smartphone" Title="From any device">
            Manage the cluster from any device with the Telegram app.
        </OverviewFeature>
        <OverviewFeature Icon="terminal" Title="Simple commands">
            A chat-based interface with command aliases.
        </OverviewFeature>
    </Features>
</ModuleOverview>
