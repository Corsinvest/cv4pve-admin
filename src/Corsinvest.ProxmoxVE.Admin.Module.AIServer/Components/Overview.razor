@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="hub" Title="MCP endpoint">
            A Model Context Protocol endpoint that AI assistants such as Claude or ChatGPT can connect to.
        </OverviewFeature>
        <OverviewFeature Icon="chat" Title="Natural language">
            Ask an AI assistant about cluster status, VMs and resources in plain words.
        </OverviewFeature>
        <OverviewFeature Icon="monitoring" Title="Real-time data">
            AI tools can query VM status, cluster health, resource usage and configuration details.
        </OverviewFeature>
        <OverviewFeature Icon="smart_toy" Title="Automated operations">
            AI assistants can run routine tasks such as VM management, snapshot creation and monitoring.
        </OverviewFeature>
        <OverviewFeature Icon="lock" Title="Controlled access">
            Only the operations exposed by the server are available to the AI tools.
        </OverviewFeature>
    </Features>
</ModuleOverview>
