@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="query_stats" Title="Prometheus export">
            Exports the key Proxmox VE metrics to Prometheus.
        </OverviewFeature>
        <OverviewFeature Icon="visibility" Title="Observability">
            Monitoring of VM, container and node performance.
        </OverviewFeature>
        <OverviewFeature Icon="notifications_active" Title="Alerting">
            Works with Prometheus Alertmanager to detect and respond to issues.
        </OverviewFeature>
        <OverviewFeature Icon="tune" Title="Custom metrics">
            Choose which Proxmox VE metrics to export.
        </OverviewFeature>
        <OverviewFeature Icon="trending_up" Title="Bottlenecks">
            Helps find resource bottlenecks and optimize cluster workloads.
        </OverviewFeature>
    </Features>
</ModuleOverview>
