@using Radzen.Blazor.Rendering
@inherits AdminComponentBase

@typeparam TWidgetSettings

<div class="cv4pve-kpi cv4pve-widget-state @StateClass" style="justify-content: center;">
    <div class="cv4pve-kpi-row" style="gap: 0.75rem;">
        <span class="cv4pve-kpi-badge @StateClass">
            <RadzenIcon Icon="@StateIcon" />
        </span>

        <div style="display: flex; flex-direction: column; min-width: 0;">
            @switch (Status)
            {
                case WidgetState.NotConfigured:
                    <span class="cv4pve-kpi-caption">@L["Not configured"]</span>
                    break;

                case WidgetState.Ok:
                    <span class="cv4pve-kpi-value" style="color: var(--rz-success);">@L["OK"]</span>
                    break;

                case WidgetState.Issues:
                    <span @ref="_badgeRef"
                          class="cv4pve-kpi-value"
                          style="@($"color: var(--rz-danger);{(Items.Any() ? " cursor: pointer; text-decoration: underline dotted;" : null)}")"
                          @onmouseenter="OpenDetails"
                          @onclick="ToggleDetails">@Count</span>
                    break;
            }

            @if (!string.IsNullOrEmpty(Message))
            {
                <span class="cv4pve-kpi-caption">@Message</span>
            }
        </div>
    </div>
</div>

@if (Items.Any())
{
    <RadzenPopup @ref="_detailsPopup"
                 Lazy="true"
                 Style="display: none; position: absolute;"
                 class="cv4pve-thumb-widget-popup rz-panel"
                 AutoFocusFirstElement="false"
                 Open="@(() => _popupOpen = true)"
                 Close="@(() => _popupOpen = false)">
        <div class="cv4pve-thumb-widget-tooltip @(Items.Count() > 5 ? "cv4pve-thumb-widget-tooltip-scroll" : "")">
            <table>
                <tbody>
                    @foreach (var item in OrderedItems)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Url))
                                {
                                    <a href="@item.Url"
                                       class="cv4pve-thumb-widget-tooltip-link">@item.Text</a>
                                }
                                else
                                {
                                    @item.Text
                                }
                            </td>
                            <td class="rz-text-align-right">@item.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </RadzenPopup>
}

@code {
    private ElementReference _badgeRef;
    private RadzenPopup _detailsPopup = default!;
    private bool _popupOpen;

    private IEnumerable<Data> OrderedItems => Items.OrderByDescending(a => a.Count);

    private string StateClass => Status switch
    {
        WidgetState.Ok => "ok",
        WidgetState.Issues => "ko",
        _ => "neutral"
    };

    private string StateIcon => Status switch
    {
        WidgetState.Ok => "check_circle",
        WidgetState.Issues => "error",
        _ => "settings"
    };

    private async Task OpenDetails()
    {
        if (!Items.Any() || _popupOpen) { return; }
        await _detailsPopup.ToggleAsync(_badgeRef);
    }

    private async Task ToggleDetails()
    {
        if (!Items.Any()) { return; }
        await _detailsPopup.ToggleAsync(_badgeRef);
    }
}
