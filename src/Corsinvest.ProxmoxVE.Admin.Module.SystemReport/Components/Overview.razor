@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="description" Title="Infrastructure documentation">
            Detailed reports on clusters, nodes, VMs and storage, for audits and documentation.
        </OverviewFeature>
        <OverviewFeature Icon="trending_up" Title="Capacity planning">
            Resource utilization data to support growth and optimization decisions.
        </OverviewFeature>
        <OverviewFeature Icon="settings" Title="Configuration analysis">
            System configurations, VM specifications and storage allocations.
        </OverviewFeature>
        <OverviewFeature Icon="download" Title="Export">
            Reports in multiple formats for sharing and archiving.
        </OverviewFeature>
    </Features>
</ModuleOverview>
