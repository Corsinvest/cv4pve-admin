@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="dns" Title="Multiple clusters">
            Connect and manage several Proxmox VE clusters from one place.
        </OverviewFeature>
        <OverviewFeature Icon="admin_panel_settings" Title="Permissions">
            Roles that define who can access what.
        </OverviewFeature>
        <OverviewFeature Icon="group" Title="Users">
            Accounts, authentication and sessions.
        </OverviewFeature>
        <OverviewFeature Icon="security" Title="Security">
            Two-factor authentication and audit logs.
        </OverviewFeature>
        <OverviewFeature Icon="new_releases" Title="Release management">
            Update notifications and changelogs.
        </OverviewFeature>
        <OverviewFeature Icon="notifications" Title="Notifications">
            Alerts sent through external notification systems.
        </OverviewFeature>
    </Features>
</ModuleOverview>
