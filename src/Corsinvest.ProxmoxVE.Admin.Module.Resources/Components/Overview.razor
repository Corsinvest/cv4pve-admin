@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="monitor_heart" Title="System health">
            CPU, memory and storage usage across all cluster nodes.
        </OverviewFeature>
        <OverviewFeature Icon="computer" Title="VM status">
            Running, stopped and error states of VMs and containers.
        </OverviewFeature>
        <OverviewFeature Icon="storage" Title="Storage monitoring">
            Capacity, performance and backup status indicators.
        </OverviewFeature>
        <OverviewFeature Icon="lan" Title="Network health">
            Connectivity and bandwidth utilization metrics.
        </OverviewFeature>
        <OverviewFeature Icon="play_circle" Title="Quick actions">
            Start, stop and restart VMs directly from the status view.
        </OverviewFeature>
        <OverviewFeature Icon="speed" Title="Performance metrics">
            Real-time CPU, memory and I/O statistics.
        </OverviewFeature>
    </Features>
</ModuleOverview>
