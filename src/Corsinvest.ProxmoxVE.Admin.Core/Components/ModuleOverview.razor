@inherits AdminComponentBase
@typeparam TModule where TModule : ModuleBase

@if (Tiles.Count > 0)
{
    <div>
        <RadzenTileLayout Columns="@GridCols"
                          RowHeight="@RowHeightPx"
                          Gap="10">
            @foreach (var tile in Tiles)
            {
                <RadzenTileLayoutItem Col="@tile.Col"
                                      Row="@tile.Row"
                                      ColSpan="@tile.ColSpan"
                                      RowSpan="@tile.RowSpan">
                    <HeaderTemplate>
                        <span title="@tile.Description"
                              style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600;">@L[tile.Title]</span>
                    </HeaderTemplate>
                    <ChildContent>
                        <div style="height: 100%;">
                            <DynamicComponent Type="@tile.Type" Parameters="@tile.Parameters" />
                        </div>
                    </ChildContent>
                </RadzenTileLayoutItem>
            }
        </RadzenTileLayout>
    </div>
}

@if (Features != null)
{
    <div class="cv4pve-overview-section-title @(Tiles.Count > 0 ? "rz-mt-6" : null)">@L["Features"]</div>
    <div class="cv4pve-overview-features">
        @Features
    </div>
}
