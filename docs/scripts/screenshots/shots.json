{
  "viewport": { "width": 1440, "height": 900 },
  "shots": [
    {
      "id": "login",
      "file": "getting-started/login.jpg",
      "auth": false,
      "url": "/Login",
      "actions": [
        { "fill": "input[name=Username]", "value": "admin@local" },
        { "fill": "input[name=Password]", "value": "Password123!" }
      ],
      "clip": [".rz-card:has(input[name=Username])"],
      "padding": 0,
      "badges": [
        { "n": 1, "selector": "input[name=Username]" },
        { "n": 2, "selector": "input[name=Password]" },
        { "n": 3, "selector": "button[type=submit]" }
      ]
    },
    {
      "id": "password-warning",
      "file": "getting-started/password-warning.png",
      "url": "/",
      "actions": [
        { "waitFor": ".rz-dialog input[name=Name]" },
        { "press": "Escape" },
        { "wait": 800 }
      ],
      "clip": [".rz-notification-item:has-text('Security Warning')"],
      "isolate": true,
      "padding": 24,
      "boxes": ["a:has-text('Change password now')"]
    },
    {
      "id": "first-cluster",
      "file": "getting-started/first-cluster.png",
      "url": "/",
      "actions": [
        { "waitFor": ".rz-dialog input[name=Name]" },
        { "click": ".rz-dialog button:has-text('Add node')" },
        { "waitFor": "input[name='Node0.IPAddress']" },
        { "fill": "input[name=Name]", "value": "cvtest" },
        { "fill": "input[name=Description]", "value": "Test cluster" },
        { "fill": "input[name='Node0.IPAddress']", "value": "10.0.99.1" },
        { "fill": "input[name='Node0.ApiPort']", "value": "8006" },
        { "fill": "input[name=ApiUsername]", "value": "root@pam" },
        { "fill": ".rz-dialog input[name=Password]", "value": "proxmox123" }
      ],
      "badges": [
        { "n": 1, "selector": "input[name=Name]" },
        { "n": 2, "selector": "input[name=Description]" },
        { "n": 3, "selector": "input[name='Node0.IPAddress']", "side": "inside-right" },
        { "n": 4, "selector": ".rz-dialog input[name=ApiUsername]" },
        { "n": 5, "selector": ".rz-dialog input[name=Password]", "side": "right" },
        { "n": 6, "selector": ".rz-dialog button:has-text('Discover Nodes')", "side": "right" },
        { "n": 7, "selector": ".rz-dialog button[type=submit]" }
      ]
    },
    {
      "id": "discover-nodes",
      "file": "configuration/clusters-discover-nodes.png",
      "url": "/",
      "actions": [
        { "waitFor": ".rz-dialog input[name=Name]" },
        { "click": ".rz-dialog button:has-text('Add node')" },
        { "waitFor": "input[name='Node0.IPAddress']" },
        { "fill": "input[name='Node0.IPAddress']", "value": "10.0.99.1" },
        { "fill": "input[name='Node0.ApiPort']", "value": "8006" },
        { "fill": "input[name=ApiUsername]", "value": "root@pam" },
        { "fill": ".rz-dialog input[name=Password]", "value": "proxmox123" },
        { "click": ".rz-dialog button:has-text('Discover Nodes')" },
        { "waitFor": "input[name='Node1.IPAddress']" },
        { "wait": 1500 }
      ],
      "expect": [
        { "selector": "input[name=Name]", "value": "cvtest" },
        { "selector": "input[name='Node2.IPAddress']", "notEmpty": true },
        { "selector": "input[name='Node3.IPAddress']", "absent": true }
      ],
      "clip": [".rz-dialog"],
      "padding": 0,
      "boxes": ["input[name=Name]"],
      "badges": [
        { "n": 1, "selector": ".rz-dialog button:has-text('Discover Nodes')", "side": "right" }
      ]
    },
    {
      "id": "admin-area-menu",
      "file": "configuration/admin-area-menu.png",
      "url": "/module/*/system/maintenance",
      "actions": [
        { "click": ".rz-profile-menu:has(.rz-gravatar)" },
        { "waitFor": ".rz-profile-menu:has(.rz-gravatar) a[href='/module/*/system']" }
      ],
      "clip": [".rz-profile-menu:has(.rz-gravatar) > li > .rz-navigation-item-wrapper", ".rz-profile-menu:has(.rz-gravatar) ul.rz-navigation-menu"],
      "badges": [
        { "n": 1, "selector": ".rz-profile-menu:has(.rz-gravatar) > li > .rz-navigation-item-wrapper" },
        { "n": 2, "selector": ".rz-profile-menu:has(.rz-gravatar) a[href='/module/*/system']" }
      ]
    },
    {
      "id": "profile-menu",
      "file": "configuration/profile-menu.png",
      "url": "/module/*/system/maintenance",
      "actions": [
        { "click": ".rz-profile-menu:has(.rz-gravatar)" },
        { "waitFor": ".rz-profile-menu:has(.rz-gravatar) a[href='/module/*/profile']" }
      ],
      "clip": [".rz-profile-menu:has(.rz-gravatar) > li > .rz-navigation-item-wrapper", ".rz-profile-menu:has(.rz-gravatar) ul.rz-navigation-menu"],
      "boxes": [".rz-profile-menu:has(.rz-gravatar) a[href='/module/*/profile']"],
      "badges": [
        { "n": 1, "selector": ".rz-profile-menu:has(.rz-gravatar) > li > .rz-navigation-item-wrapper" }
      ]
    },
    {
      "id": "maintenance",
      "file": "configuration/maintenance.png",
      "url": "/module/*/system/maintenance",
      "actions": [{ "waitFor": "button:has-text('Fix All')" }],
      "clip": ["fieldset:has-text('Database Maintenance')", "fieldset:has-text('content_copy')", "button:has-text('Fix All')"]
    },
    {
      "id": "maintenance-connectivity",
      "file": "configuration/maintenance-connectivity.png",
      "url": "/module/*/system/maintenance",
      "actions": [
        { "click": "button:has-text('Test Cluster Connections')" },
        { "waitFor": "fieldset:has-text('content_copy') :text('cvtest')" },
        { "wait": 1500 }
      ],
      "clip": ["fieldset:has-text('Connectivity Tests')", "fieldset:has-text('content_copy')"],
      "badges": [
        { "n": 1, "selector": "button:has-text('Test Cluster Connections')" }
      ]
    },
    {
      "id": "general-smtp",
      "file": "configuration/general-settings-smtp.png",
      "url": "/module/*/system/general",
      "actions": [
        { "click": "button:has-text('SMTP Configuration') .rzi >> nth=0" },
        { "waitFor": "input[name$='.Host']" },
        { "wait": 1000 },
        { "fill": "input[placeholder='user@example.com']", "value": "jane.doe@example.com" }
      ],
      "expect": [{ "selector": "input[name$='.Host']", "notEmpty": true }],
      "clip": [".rz-form-field:has(input[name$='.Host'])", ".rz-card:has-text('Test SMTP Configuration')", "button:has-text('Save changes') >> nth=0"],
      "badges": [
        { "n": 1, "selector": "input[placeholder='user@example.com']", "side": "inside-right" },
        { "n": 2, "selector": "button:has-text('Send')", "side": "right" }
      ]
    },
    {
      "id": "system-information",
      "file": "configuration/monitoring-system-information.png",
      "url": "/module/*/system/system+information",
      "padding": 0,
      "clip": [".rz-data-grid"]
    },
    {
      "id": "tasks",
      "file": "configuration/monitoring-tasks.png",
      "url": "/module/*/system/tasks",
      "actions": [{ "waitFor": ".rz-data-row :text('Backup Analytics scan')" }],
      "padding": 8,
      "clip": ["button:has-text('Refresh')", ".rz-data-row >> nth=-1"]
    },
    {
      "id": "active-sessions",
      "file": "configuration/security-active-sessions.png",
      "url": "/module/*/system/active+sessions",
      "actions": [{ "waitFor": ".rz-data-row" }],
      "padding": 8,
      "clip": ["button:has-text('Refresh')", ".rz-data-row >> nth=-1"]
    },
