    {
      "id": "profile-2fa-enable",
      "edition": "ee",
      "file": "configuration/profile-2fa-enable.png",
      "url": "/module/*/profile/2fa",
      "actions": [{ "waitFor": "button:has-text('Enable 2FA')" }],
      "clip": [".rz-alert", "button:has-text('Enable 2FA')"],
