@inherits AdminComponentBase
@using Corsinvest.ProxmoxVE.Admin.Core.Hooks

<RadzenFormField Text="@L["URL"]" AllowFloatingLabel="false">
    <Start><RadzenIcon Icon="link" /></Start>
    <ChildContent>
        <RadzenTextBox Name="@($"{Prefix}.Url")" @bind-Value="@Value.Url" />
    </ChildContent>
    <Helper>
        <RadzenDataAnnotationValidator Component="@($"{Prefix}.Url")" />
    </Helper>
</RadzenFormField>

<RadzenFormField Text="@L["Method"]" AllowFloatingLabel="false">
    <Start><RadzenIcon Icon="http" /></Start>
    <ChildContent>
        <EnumDropDown Name="@($"{Prefix}.Method")" @bind-Value="@Value.Method" />
    </ChildContent>
    <End>
        <InfoIcon>
            <strong>@L["Get"]:</strong> @L["Retrieve data without side effects"]<br />
            <strong>@L["Post"]:</strong> @L["Send data to create a resource"]<br />
            <strong>@L["Put"]:</strong> @L["Replace a resource entirely"]<br />
            <strong>@L["Patch"]:</strong> @L["Partially update a resource"]<br />
            <strong>@L["Delete"]:</strong> @L["Remove a resource"]
        </InfoIcon>
    </End>
</RadzenFormField>

@if (Value.Method != WebHookHttpMethod.Get)
{
<RadzenFormField Text="@L["Body Type"]" AllowFloatingLabel="false">
    <Start><RadzenIcon Icon="data_object" /></Start>
    <ChildContent>
        <EnumDropDown Name="@($"{Prefix}.BodyType")" @bind-Value="@Value.BodyType" />
    </ChildContent>
    <End>
        <InfoIcon>
            <strong>@L["None"]:</strong> @L["No body"]<br />
            <strong>@L["JSON"]:</strong> @L["application/json"]<br />
            <strong>@L["XML"]:</strong> @L["application/xml"]<br />
            <strong>@L["Text"]:</strong> @L["text/plain"]
        </InfoIcon>
    </End>
</RadzenFormField>

<RadzenFormField Text="@L["Body"]" AllowFloatingLabel="false" Helper="@BodyHelper">
    <Start><RadzenIcon Icon="notes" /></Start>
    <ChildContent>
        <RadzenTextArea Name="@($"{Prefix}.Body")" @bind-Value="@Value.Body" Rows="5" />
    </ChildContent>
</RadzenFormField>
}

<RadzenPanel Text="@L["Auth"]">
    <RadzenStack Orientation="Orientation.Vertical">
        <RadzenFormField Text="@L["Type"]" AllowFloatingLabel="false">
            <Start><RadzenIcon Icon="security" /></Start>
            <ChildContent>
                <EnumDropDown Name="@($"{Prefix}.AuthType")" @bind-Value="@Value.Auth.Type" />
            </ChildContent>
            <End>
                <InfoIcon>
                    <strong>@L["None"]:</strong> @L["No authentication"]<br />
                    <strong>@L["Basic"]:</strong> @L["Username and password"]<br />
                    <strong>@L["Bearer"]:</strong> @L["Bearer token in Authorization header"]<br />
                    <strong>@L["API Key"]:</strong> @L["Custom header with API key"]
                </InfoIcon>
            </End>
        </RadzenFormField>

        @if (Value.Auth.Type == WebHookAuthType.Basic)
        {
            <RadzenFormField Text="@L["Username"]" AllowFloatingLabel="false">
                <Start><RadzenIcon Icon="account_circle" /></Start>
                <ChildContent>
                    <RadzenTextBox @bind-Value="@Value.Auth.Username" />
                </ChildContent>
            </RadzenFormField>
            <PasswordField Label="@L["Password"]" @bind-Value="@Value.Auth.Password" />
        }
        else if (Value.Auth.Type == WebHookAuthType.Bearer)
        {
            <PasswordField Label="@L["Token"]" @bind-Value="@Value.Auth.Token" />
        }
        else if (Value.Auth.Type == WebHookAuthType.ApiKey)
        {
            <RadzenFormField Text="@L["Header Name"]" AllowFloatingLabel="false">
                <Start><RadzenIcon Icon="label" /></Start>
                <ChildContent>
                    <RadzenTextBox @bind-Value="@Value.Auth.ApiKeyHeader" />
                </ChildContent>
            </RadzenFormField>
            <PasswordField Label="@L["Header Value"]" @bind-Value="@Value.Auth.ApiKeyValue" />
        }
    </RadzenStack>
</RadzenPanel>

<RadzenPanel Text="@L["Headers"]">
    <ListEditor TItem="HeaderRow"
                Items="@_headers"
                NewItem="@(() => new HeaderRow())"
                AddText="@L["Add header"]"
                Changed="@UpdateHeaders">
        <ItemTemplate Context="header">
            <RadzenTextBox Placeholder="@L["Name"]"
                           Value="@header.Name"
                           ValueChanged="@((string value) => { header.Name = value; UpdateHeaders(); })"
                           class="rz-w-100" />
            <RadzenTextBox Placeholder="@L["Value"]"
                           Value="@header.Value"
                           ValueChanged="@((string value) => { header.Value = value; UpdateHeaders(); })"
                           class="rz-w-100" />
        </ItemTemplate>
    </ListEditor>
</RadzenPanel>

<RadzenFormField Text="@L["Timeout (seconds)"]" AllowFloatingLabel="false">
    <Start><RadzenIcon Icon="timer" /></Start>
    <ChildContent>
        <RadzenNumeric Name="@($"{Prefix}.TimeoutSeconds")" @bind-Value="@Value.TimeoutSeconds" Min="1" Max="300" />
    </ChildContent>
</RadzenFormField>

<SwitchField @bind-Value="@Value.IgnoreSslCertificate"
             Label="@L["Ignore SSL Certificate"]"
             Name="@($"{Prefix}.IgnoreSslCertificate")"
             class="rz-w-100" />

@code {
    [Parameter] public WebHook Value { get; set; } = default!;
    [Parameter] public EventCallback<WebHook> ValueChanged { get; set; }
    [Parameter] public RenderFragment? BodyHelper { get; set; }

    private string Prefix { get; set; } = $"WebHook_{Guid.NewGuid():N}";

    // Rows edited in the UI: a dictionary cannot hold a row whose name is still empty or being renamed
    private class HeaderRow
    {
        public string Name { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private List<HeaderRow> _headers = [];
    private WebHook? _loadedFrom;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedFrom, Value))
        {
            _loadedFrom = Value;
            _headers = [.. Value.Headers.Select(a => new HeaderRow { Name = a.Key, Value = a.Value })];
        }
    }

    // Rows without a name are skipped; with a repeated name the last row wins
    private void UpdateHeaders()
        => Value.Headers = _headers.Where(a => !string.IsNullOrWhiteSpace(a.Name))
                                   .GroupBy(a => a.Name.Trim(), StringComparer.OrdinalIgnoreCase)
                                   .ToDictionary(a => a.Key, a => a.Last().Value);
}
