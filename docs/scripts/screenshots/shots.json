        { "click": "button:has-text('New') >> visible=true" },
        { "waitFor": ".rz-dialog-side input[name$='.Url']" },
        { "fill": ".rz-dialog-side input[name=Name]", "value": "Operations alerts" },
        { "fill": ".rz-dialog-side input[name$='.Url']", "value": "https://hooks.example.com/cv4pve-admin" }
      ],
      "clip": [".rz-dialog-side"],
      "padding": 0
    },
    {
      "id": "profile-preferences",
      "file": "configuration/profile-preferences.png",
      "url": "/module/*/profile/preferences",
      "actions": [
        { "click": "button:has-text('Language') .rzi >> nth=0" },
        { "waitFor": "button:has-text('Save changes')" }
      ],
      "clip": [".rz-accordion"],
      "badges": [
        { "n": 1, "selector": ".rz-accordion .rz-dropdown" },
        { "n": 2, "selector": "button:has-text('Save changes')" }
      ]
    },
    {
      "id": "profile-password",
      "file": "configuration/profile-password.png",
      "url": "/module/*/profile/password",
      "actions": [{ "waitFor": "button:has-text('Update password')" }],
      "clip": [".rz-form-field:has(input[type=password]) >> nth=0", "button:has-text('Update password')"],
      "badges": [
        { "n": 1, "selector": "input[type=password] >> nth=0" },
        { "n": 2, "selector": "input[type=password] >> nth=1" },
        { "n": 3, "selector": "input[type=password] >> nth=2" },
        { "n": 4, "selector": "button:has-text('Update password')" }
      ]
    },
    {
      "id": "users-dialog",
      "edition": "ee",
      "file": "configuration/security-user.png",
      "url": "/module/*/system/security/users",
      "actions": [
        { "click": ".rz-data-row :text-is('jane.doe@example.com')" },
        { "waitFor": ".rz-dialog-side input[name=Email]" },
        { "wait": 800 }
