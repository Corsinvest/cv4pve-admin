@inherits AdminComponentBase

<RadzenPanel>
    <CrudToolbar OnRefresh="RefreshDataAsync" InRefresh="@InRefresh" />

    <RadzenTimeline AlignItems="AlignItems.Start" LinePosition="LinePosition.Start" Orientation="Orientation.Vertical">
        <Items>
            @foreach (var item in Items)
            {
                var expanded = _expanded.Contains(item.Date);

                <RadzenTimelineItem PointStyle="@GetPointStyle(item)" PointVariant="Variant.Flat">
                    <PointContent>
                        <RadzenIcon Icon="@(item.Failed == 0 ? "check" : "priority_high")" Style="font-size: 1rem;" />
                    </PointContent>

                    <ChildContent>
                        <RadzenCard Variant="Variant.Outlined" Style="width: 100%; padding: 0.75rem 1rem; margin-bottom: 0.5rem;">
                            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; cursor: pointer;"
                                 @onclick="@(() => Toggle(item.Date))">

                                <div style="display: flex; align-items: center; gap: 0.6rem; min-width: 9rem;">
                                    <div style="font-size: 2rem; font-weight: 600; line-height: 1;">@item.Date.Day</div>
                                    <div style="display: flex; flex-direction: column; line-height: 1.2;">
                                        <span style="font-weight: 600; text-transform: capitalize;">@item.Date.ToString("dddd")</span>
                                        <span class="rz-text-secondary-color" style="font-size: 0.8rem; text-transform: capitalize;">
                                            @(GetRelativeDay(item.Date) ?? item.Date.ToString("MMMM yyyy"))
                                        </span>
                                    </div>
                                </div>

                                <div style="flex: 1; min-width: 14rem;">
                                    <div style="display: flex; gap: 2px;">
                                        @for (var hour = 0; hour < 24; hour++)
                                        {
                                            var slot = item.Hours[hour];
                                            <div title="@GetSlotTitle(hour, slot)"
                                                 style="flex: 1; height: 1.1rem; border-radius: 3px; background: @GetSlotColor(slot);"></div>
                                        }
                                    </div>
                                    <div class="rz-text-secondary-color" style="display: flex; justify-content: space-between; font-size: 0.7rem; margin-top: 2px;">
                                        <span>00</span><span>06</span><span>12</span><span>18</span><span>24</span>
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <RadzenBadge Text="@L["{0} snapshots", item.Count]" BadgeStyle="BadgeStyle.Info" Shade="Shade.Lighter" IsPill="true" />
                                    @if (item.Failed > 0)
                                    {
                                        <RadzenBadge Text="@L["{0} failed", item.Failed]" BadgeStyle="BadgeStyle.Danger" Shade="Shade.Lighter" IsPill="true" />
                                    }
                                    @if (AllowCalculateSnapshotSize)
                                    {
                                        <RadzenBadge Text="@(IsCalculateSnapshotSize ? "..." : FormatHelper.FromBytes(item.SnapshotsSize))"
                                                     BadgeStyle="BadgeStyle.Base"
                                                     Shade="Shade.Lighter"
                                                     IsPill="true" />
                                    }
                                    <RadzenIcon Icon="@(expanded ? "expand_less" : "expand_more")" class="rz-text-secondary-color" />
                                </div>
                            </div>

                            @if (expanded)
                            {
                                <RadzenDataGrid TItem="DataSnapshot"
                                                Data="@item.Snapshots"
                                                AllowFiltering="true"
                                                AllowColumnResize="true"
                                                AllowAlternatingRows="false"
                                                AllowSorting="true"
                                                Density="Density.Compact"
                                                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Style="margin-top: 0.75rem;">
                                    <Columns>
                                        <RadzenDataGridColumn Property="@nameof(DataSnapshot.Job)" Sortable="true" Title="@L["Job"]" />
                                        <RadzenDataGridColumn Property="@nameof(DataSnapshot.SnapName)" Sortable="true" Title="@L["Name"]" />
                                        <DateTimeLocalColumn Property="@nameof(DataSnapshot.Start)" Sortable="true" Title="@L["Start"]" SortOrder="SortOrder.Descending" />
                                        <RadzenDataGridColumn Property="@nameof(DataSnapshot.Duration)" Sortable="true" Title="@L["Duration"]" FormatString="{0:hh':'mm':'ss}" />
                                        <SnapshotSizeColumn Property="@nameof(DataSnapshot.SnapshotsSize)" ShowWating="IsCalculateSnapshotSize" Visible="AllowCalculateSnapshotSize" />
                                        <BoolIconColumn Property="@nameof(DataSnapshot.Status)" Title="@L["Status"]" IconFalse="" />
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </RadzenCard>
                    </ChildContent>
                </RadzenTimelineItem>
            }
        </Items>
    </RadzenTimeline>

    @if (HasMore)
    {
        <div style="display: flex; justify-content: center;">
            <RadzenButton Text="@L["Show more"]"
                          Icon="expand_more"
                          Variant="Variant.Text"
                          ButtonStyle="ButtonStyle.Base"
                          Click="ShowMoreAsync" />
        </div>
    }
</RadzenPanel>
