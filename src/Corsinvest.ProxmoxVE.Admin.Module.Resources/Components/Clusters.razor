@inherits AdminComponentBase

<div class="cv4pve-fill-page">
    <Summary ClusterName="@ClusterName" />

    <div class="cv4pve-card cv4pve-fill-tabs" style="height: auto; padding: 0;">
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="@L["Tasks"]" Icon="list_alt">
                    <Corsinvest.ProxmoxVE.Admin.Core.Components.ProxmoxVE.Common.Tasks Style="height: 100%;" ClusterName="@ClusterName" />
                </RadzenTabsItem>

                <RadzenTabsItem Text="@L["Logs"]" Icon="article">
                    <Logs Style="height: 100%;" ClusterName="@ClusterName" />
                </RadzenTabsItem>

                <RadzenTabsItem Text="@L["Snapshots Usage"]" Icon="@PveAdminUIHelper.Icons.Snapshot">
                    <Corsinvest.ProxmoxVE.Admin.Core.Components.ProxmoxVE.Cluster.Snapshots ClusterName="@ClusterName" />
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </div>
</div>

@code
{
    [CascadingParameter(Name = nameof(ClusterName))] public string ClusterName { get; set; } = default!;
}
