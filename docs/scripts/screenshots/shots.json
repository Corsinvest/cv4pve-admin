        { "waitFor": ".rz-dialog-side input[name=Name]" },
        { "click": ".rz-dialog-side .rz-tabview-nav li:has-text('Permissions')" },
        { "wait": 1000 },
        { "click": ".rz-dialog-side li:has-text('By Permission')" },
        { "wait": 1500 },
        { "click": ".rz-dialog-side .rz-switch >> visible=true" },
        { "wait": 1500 }
      ],
      "clip": [".rz-dialog-side"],
      "padding": 0
    },
    {
      "id": "app-tokens",
      "edition": "ee",
      "file": "configuration/security-app-tokens.png",
      "url": "/module/*/system/app+tokens",
      "actions": [{ "waitFor": ".rz-data-row :text('monitoring')" }],
      "padding": 8,
      "clip": ["button:has-text('New')", ".rz-data-row >> nth=-1"]
    },
