@inherits AdminComponentBase
@implements IDisposable
@inject IBrowserService BrowserService
@inject NotificationService NotificationService

<RadzenButton Icon="@(Copied ? "check" : "content_copy")"
              IconColor="@(Copied ? Colors.Success : null)"
              Variant="Variant.Text"
              Size="@Size"
              Text="@Text"
              Disabled="@Disabled"
              Click="CopyAsync"
              title="@Label"
              aria-label="@Label" />

@code {
    [Parameter] public Func<string>? TextProvider { get; set; }
    [Parameter] public Func<Task<string>>? TextProviderAsync { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Small;
    [Parameter] public string? Text { get; set; }

    private static readonly TimeSpan ShownFor = TimeSpan.FromSeconds(2);
    private bool Copied { get; set; }
    private CancellationTokenSource? _reset;

    private string Label => Copied ? L["Copied!"] : L["Copy to clipboard"];

    private async Task CopyAsync()
    {
        var text = TextProviderAsync is not null
                            ? await TextProviderAsync()
                            : TextProvider?.Invoke();

        if (text is null) { return; }

        try
        {
            await BrowserService.CopyToClipboardAsync(text);
        }
        catch (Exception ex)
        {
            NotificationService.Error(L["Copy failed"], ex.Message);
            return;
        }

        // The check mark stays for a moment, then the icon goes back: a second click starts the time again
        _reset?.Cancel();
        _reset?.Dispose();
        _reset = new();
        Copied = true;
        StateHasChanged();

        try
        {
            await Task.Delay(ShownFor, _reset.Token);
            Copied = false;
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        _reset?.Cancel();
        _reset?.Dispose();
    }
}
