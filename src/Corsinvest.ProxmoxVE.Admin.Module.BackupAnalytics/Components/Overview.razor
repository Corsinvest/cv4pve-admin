@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="monitor_heart" Title="Real-time status">
            Live backup job monitoring with instant failure detection.
        </OverviewFeature>
        <OverviewFeature Icon="speed" Title="Performance tracking">
            Duration analysis, throughput metrics and resource usage.
        </OverviewFeature>
        <OverviewFeature Icon="notifications_active" Title="Proactive alerts">
            Notifications for failed, slow or inefficient backups.
        </OverviewFeature>
        <OverviewFeature Icon="history" Title="Historical analysis">
            Long-term trends for capacity planning and optimization.
        </OverviewFeature>
        <OverviewFeature Icon="bug_report" Title="Failure diagnosis">
            Detailed logs and patterns to quickly resolve backup issues.
        </OverviewFeature>
        <OverviewFeature Icon="storage" Title="Storage insights">
            Growth projections and space utilization analytics.
        </OverviewFeature>
    </Features>
</ModuleOverview>
