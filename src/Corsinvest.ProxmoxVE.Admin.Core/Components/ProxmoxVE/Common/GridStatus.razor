@inherits AdminComponentBase

<div class="cv4pve-kpi cv4pve-widget-state @StateClass">
    <div class="cv4pve-kpi-head">
        <span class="cv4pve-kpi-value">@Items.Sum(a => a.Count)</span>
        @if (!string.IsNullOrEmpty(Title))
        {
            <span class="cv4pve-kpi-caption">@Title</span>
        }
    </div>

    @if (Items.Count() > 1)
    {
        <div class="cv4pve-kpi-bar">
            @foreach (var item in Items.Where(a => a.Count > 0))
            {
                <span style="@($"flex: {item.Count}; background: {item.Color};")" title="@($"{L[item.Status]}: {item.Count}")"></span>
            }
        </div>
    }

    <div class="cv4pve-kpi-list">
        @foreach (var item in Items)
        {
            <div class="cv4pve-kpi-row">
                <RadzenIcon Icon="@item.Icon" IconColor="@item.Color" Style="--rz-icon-fill: 1; font-size: 18px;" />
                <span>@L[item.Status]</span>
                <span class="cv4pve-kpi-row-count">@item.Count</span>
            </div>
        }
    </div>
</div>

@code
{
    [EditorRequired, Parameter] public IEnumerable<ItemStatus> Items { get; set; } = [];
    [Parameter] public string? Title { get; set; }

    private string StateClass
        => !Items.Any()
            ? "neutral"
            : Items.Any(a => a.Count > 0 && (a.Status == PveConstants.StatusOffline || a.Status == PveConstants.StatusUnknown))
                ? "ko"
                : "ok";
}
