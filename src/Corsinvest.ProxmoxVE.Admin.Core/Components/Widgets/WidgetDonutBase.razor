@inherits AdminComponentBase
@typeparam TSettings

<div class="cv4pve-kpi cv4pve-widget-state @StateClass">
    <div class="cv4pve-kpi-head">
        <span class="cv4pve-kpi-value">@Total</span>
        <span class="cv4pve-kpi-caption">@SerieTitle</span>
    </div>

    <div class="cv4pve-kpi-bar">
        @foreach (var item in Items.Where(a => a.Count > 0))
        {
            <span style="@($"flex: {item.Count}; background: {item.Color};")" title="@($"{L[item.Category]}: {item.Count}")"></span>
        }
    </div>

    <div class="cv4pve-kpi-list">
        @foreach (var item in Items)
        {
            <div class="cv4pve-kpi-row" style="@(item.Count == 0 ? "opacity: 0.55;" : null)">
                <span class="cv4pve-kpi-dot" style="@($"background: {item.Color};")"></span>
                <span>@L[item.Category]</span>
                <span class="cv4pve-kpi-row-count">@item.Count</span>
            </div>
        }
    </div>

    @if (Title != null)
    {
        @Title
    }

    @if (Footer != null)
    {
        <div class="cv4pve-kpi-footer">@Footer</div>
    }
</div>
