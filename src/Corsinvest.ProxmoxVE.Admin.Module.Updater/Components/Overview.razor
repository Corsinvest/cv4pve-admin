@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="security" Title="Security patches">
            Finds the critical security patches pending on VMs and containers.
        </OverviewFeature>
        <OverviewFeature Icon="inventory_2" Title="Update inventory">
            Available updates by system, package and severity.
        </OverviewFeature>
        <OverviewFeature Icon="assessment" Title="Compliance reporting">
            Patch status reports for security audits.
        </OverviewFeature>
        <OverviewFeature Icon="event" Title="Maintenance planning">
            Plan the maintenance windows from what is pending.
        </OverviewFeature>
        <OverviewFeature Icon="visibility" Title="Non-intrusive">
            It only checks for updates and changes nothing.
        </OverviewFeature>
    </Features>
</ModuleOverview>
