@inherits AdminComponentBase

<ModuleOverview TModule="Module">
    <Features>
        <OverviewFeature Icon="sync" Title="Replication status">
            Checks that VM and CT replications run correctly.
        </OverviewFeature>
        <OverviewFeature Icon="speed" Title="Performance analytics">
            Replication speed, success rates and failure patterns.
        </OverviewFeature>
        <OverviewFeature Icon="notifications_active" Title="Proactive monitoring">
            Detects issues early, before failures impact availability.
        </OverviewFeature>
        <OverviewFeature Icon="history" Title="Historical analysis">
            Long-term trends to optimize replication policies.
        </OverviewFeature>
        <OverviewFeature Icon="build" Title="Troubleshooting">
            Helps diagnose and resolve replication issues quickly.
        </OverviewFeature>
    </Features>
</ModuleOverview>
