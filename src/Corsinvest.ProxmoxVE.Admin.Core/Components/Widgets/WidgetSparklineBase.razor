@inherits AdminComponentBase
@typeparam TItem
@typeparam TSettings

<div class="cv4pve-kpi">
    <div class="cv4pve-kpi-head">
        <span class="cv4pve-kpi-value">@(CurrentValue ?? "-")</span>
        <span class="cv4pve-kpi-caption">@SerieTitle</span>
    </div>

    @if (Items.Any())
    {
        <RadzenSparkline Style="flex: 1; min-height: 2rem;">
            <RadzenAreaSeries Data="@Items"
                              Smooth="true"
                              Title="@SerieTitle"
                              CategoryProperty="@CategoryProperty"
                              ValueProperty="@ValueProperty">
                <RadzenMarkers Visible="false" />
            </RadzenAreaSeries>

            <RadzenValueAxis Formatter="@ValueFormatter" Visible="false" />
        </RadzenSparkline>
    }
    else
    {
        <span class="cv4pve-kpi-caption">@L["No data"]</span>
    }

    @if (Footer != null)
    {
        <div class="cv4pve-kpi-footer">@Footer</div>
    }
</div>
